# Luna Scope Environment Configuration
# Copy this file to .env at the repository root (or per-service) before running.

# ==============================================================================
# Frontend (Vite / React)
# ==============================================================================
# Base URL of the FastAPI backend reachable by the browser
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=Luna Scope

# ==============================================================================
# Backend (FastAPI / Astropy / JPL Ephemeris)
# ==============================================================================
# Host and port for Uvicorn server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Allowed CORS origins (comma-separated, or * for local development)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Astropy / JPL ephemeris cache & config directories
XDG_CACHE_HOME=/tmp/cache
XDG_CONFIG_HOME=/tmp/config

# Optional NASA API key (for extended LROC / JPL data queries)
NASA_API_KEY=DEMO_KEY
